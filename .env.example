APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL=http://localhost
APP_URL=http://localhost:8000
# APP_URL=https://absen.milosgo.com
INTERNAL_API_URL= http://localhost:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
